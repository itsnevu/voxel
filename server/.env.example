# ============================================================================
# Reel Fortune 3D — server configuration
# Copy to `.env` and edit. Never commit the real `.env`.
#   cp .env.example .env
# ============================================================================

# Port the Node process listens on. It binds to 127.0.0.1 only, so nginx (or
# another reverse proxy) is what actually faces the internet.
PORT=8787

# Where the SQLite file lives. Relative paths resolve from the process working
# directory — the systemd unit sets that to the server folder, so ./data/… lands
# in server/data. Put it on a persistent disk and make sure the service user can
# write to the *directory* too: SQLite creates -wal and -shm siblings.
DB_PATH=./data/reelfortune.db

# Browsers allowed to call the API. '*' is fine while the game is served from
# this same origin (the default setup). If the client is hosted elsewhere, list
# the exact origins, comma separated — that also switches CORS credentials on,
# which a wildcard can never do.
#   CORS_ORIGIN=https://reelfortune.example.com,https://www.reelfortune.example.com
CORS_ORIGIN=*

# Folder containing index.html, game.js and lib/, served as static files.
# Resolved from the server package root, so the default points at the project
# root one level up. Requests for /server, /contracts, /.git, /.env and
# /node_modules are refused regardless of this setting.
GAME_DIR=../

# HMAC key for Isle Ledger deed claims (/api/ledger/claim).
# REQUIRED in production — without it claim signing returns 503. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every signature already handed out.
# NOTE: this signs a placeholder HMAC tag, not an on-chain-verifiable ECDSA
# signature. Minting for real means adding viem/ethers and swapping this for a
# secp256k1 private key — see the ISLE LEDGER comment in src/index.js.
LEDGER_SECRET=change-me-to-32-random-bytes

# 'production' or 'development'. In production the server hides error details
# from API responses and refuses to run the ledger on an ephemeral secret.
NODE_ENV=production

# ============================================================================
# Reel Fortune 3D — server configuration
# Copy to `.env` and edit. Never commit the real `.env`.
#   cp .env.example .env
# ============================================================================

# Port the Node process listens on. It binds to 127.0.0.1 only, so nginx (or
# another reverse proxy) is what actually faces the internet.
PORT=8787

# Where the SQLite file lives. Relative paths resolve from the process working
# directory — the systemd unit sets that to the server folder, so ./data/… lands
# in server/data. Put it on a persistent disk and make sure the service user can
# write to the *directory* too: SQLite creates -wal and -shm siblings.
DB_PATH=./data/reelfortune.db

# Browsers allowed to call the API. '*' is fine while the game is served from
# this same origin (the default setup). If the client is hosted elsewhere, list
# the exact origins, comma separated — that also switches CORS credentials on,
# which a wildcard can never do.
#   CORS_ORIGIN=https://reelfortune.example.com,https://www.reelfortune.example.com
CORS_ORIGIN=*

# Folder containing index.html, game.js and lib/, served as static files.
# Resolved from the server package root, so the default points at the project
# root one level up. Requests for /server, /contracts, /.git, /.env and
# /node_modules are refused regardless of this setting.
GAME_DIR=../

# HMAC key for Isle Ledger deed claims (/api/ledger/claim).
# REQUIRED in production — without it claim signing returns 503. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every signature already handed out.
# NOTE: this signs a placeholder HMAC tag, not an on-chain-verifiable ECDSA
# signature. Minting for real means adding viem/ethers and swapping this for a
# secp256k1 private key — see the ISLE LEDGER comment in src/index.js.
LEDGER_SECRET=change-me-to-32-random-bytes

# 'production' or 'development'. In production the server hides error details
# from API responses and refuses to run the ledger on an ephemeral secret.
NODE_ENV=production

# ============================================================================
# MODERATION — the console at /api/admin
# ============================================================================

# Shared secret for the moderation console. It is presented as the
# `X-Admin-Token` request header and never as a query parameter, because nginx
# writes request URLs to its access log verbatim and a token in a log file is a
# token on disk forever.
#
# LEAVING THIS EMPTY DOES NOT LOCK THE CONSOLE — IT DELETES IT. Every path under
# /api/admin answers a flat 404, which is the same answer a stranger with a
# wrong token gets, so "off" is indistinguishable from "not deployed". That is
# deliberate, but it also means a forgotten token looks exactly like a working
# server: player reports keep landing in the `reports` table, nobody can read
# them, and there is no way to mute a chat abuser or ban a cheating account.
# The only hint is a single warning at boot: "ADMIN_TOKEN is not set".
#
# Generate one and treat it like a root password — it grants every moderation
# action against every account, and it is not tied to any player login:
#   openssl rand -hex 24
# Shorter than 24 characters still works but is warned about at boot. There is
# deliberately no placeholder here: an example token shipped in the repo would
# be a *working* key on every deployment that forgot to replace it.
ADMIN_TOKEN=

# ============================================================================
# WALLET SIGN-IN
# ============================================================================

# Chain id quoted in the SIWE message that /api/auth/wallet/nonce hands out. The
# wallet is only an identity here and never signs a transaction, so the value is
# cosmetic — but it has to be present and stable or the wallet will not
# recognise the text as a sign-in request at all. 1 = Ethereum mainnet.
WALLET_CHAIN_ID=1

# ============================================================================
# OBSERVABILITY — what ends up in journalctl
# ============================================================================

# debug | info | warn | error. Anything below the chosen level is dropped
# before it is formatted, so `debug` on a busy server is genuinely expensive.
LOG_LEVEL=info

# Human-readable coloured lines instead of one JSON object per line. For a
# terminal only: journald, and every log shipper reading it, wants the JSON.
# NO_COLOR=1 keeps the readable layout but drops the ANSI escapes, which is what
# you want when piping to `less` or a file.
#LOG_PRETTY=1
#NO_COLOR=1

# Comma-separated path prefixes whose SUCCESSFUL responses drop from info to
# debug. This is the knob that stops an uptime probe hitting /api/health every
# five seconds from burying every interesting line. Errors and slow requests on
# these paths are still logged at their normal level.
#LOG_ACCESS_QUIET=/api/health,/lib

# A request taking longer than this many ms is logged as slow whatever its
# status code, including one that was quietened above.
LOG_SLOW_MS=1000

# Total budget, in ms, for the shutdown hooks that run after an uncaught
# exception — closing the listener, checkpointing SQLite. When it runs out the
# process exits anyway, so systemd's Restart= can put a healthy one in its
# place. Raise it only if a shutdown is genuinely being cut short.
FATAL_GRACE_MS=3000

# ============================================================================
# TUNING — sensible defaults; change only with a reason
# ============================================================================

# Live sessions one account may hold before the oldest token is evicted. Ten
# covers a phone, a desktop and a few stale tabs, and the cap is what stops a
# looping client from growing the sessions table without bound.
MAX_SESSIONS_PER_USER=10

# SQLite memory-mapped read window, in MB. The default is generous for this
# workload and still fits beside Node's heap on a 1 GB VPS.
DB_MMAP_MB=128

# Rescue hatch only. The boot refuses to start on a database that fails
# PRAGMA quick_check, because serving from a damaged file writes bad data on
# top of bad data. Set this to 1 solely to open a known-bad file for inspection,
# and never in a unit file — restore the newest good backup instead.
#DB_SKIP_INTEGRITY_CHECK=1

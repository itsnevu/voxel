[Unit]
Description=Reel Fortune 3D - authoritative game server
Documentation=https://github.com/itsnevu/voxel
After=network-online.target
Wants=network-online.target

# Kalau proses crash-loop terus, systemd menyerah setelah 5x gagal dalam 60 detik.
# Kedua opsi ini HARUS berada di section [Unit] (systemd >= 230), bukan [Service].
# Ubuntu 22.04 memakai systemd 249 dan 24.04 memakai 255, jadi kalau ditaruh di
# [Service] systemd hanya mencatat "Unknown lvalue" dan diam-diam mengabaikannya.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=reelfortune
Group=reelfortune

WorkingDirectory=/opt/reelfortune/server
EnvironmentFile=/opt/reelfortune/server/.env
ExecStart=/usr/bin/node src/index.js

Restart=always
RestartSec=3

# Beri waktu SQLite menutup koneksi & flush WAL dengan rapi sebelum SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=reelfortune

LimitNOFILE=65535

# ---------------------------------------------------------------------------
# Hardening
# ---------------------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectProc=invisible
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# ProtectSystem=strict membuat SELURUH filesystem read-only untuk service ini.
# Satu-satunya folder yang boleh ditulis adalah folder data SQLite
# (file .db plus -wal dan -shm milik better-sqlite3).
# Kalau DB_PATH di .env diarahkan ke lokasi lain, UBAH baris ini juga
# atau service akan gagal dengan "SQLITE_CANTOPEN: unable to open database file".
ReadWritePaths=/opt/reelfortune/server/data

# File DB & backup hanya bisa dibaca pemiliknya.
UMask=0077

# JANGAN set MemoryDenyWriteExecute=yes: JIT V8 milik Node butuh halaman
# memori write+execute, dan service tidak akan mau start kalau diaktifkan.
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
